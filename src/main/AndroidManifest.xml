<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A launcher sees every app you open, so it must never reach the network.
         tools:node="remove" strips INTERNET even if a library declares it. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- Swipe down opens the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- A launcher has to see every app: launcher icons, and widget providers whose receiver is not
         exported (a <queries> intent misses those). Harmless here: nothing can leave the device. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Wallpaper.NoTitleBar">
        <activity
            android:name=".Launcher"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="nosensor"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- "Add to home screen" from other apps. Exported because the system starts it; a forged
             intent carries no valid PinItemRequest, so it does nothing. -->
        <activity
            android:name=".PinActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
